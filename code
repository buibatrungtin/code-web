  const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InV6eWNqZG5pdmNmbmZwamNwdWJpIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODgxNTQ5MjIsImV4cCI6MjEwMzczMDkyMn0.M1a1_ICnH-RMjnvdLRe6t7fQc1V6PiLo9mRqJJwGNUk'; // lấy trong Supabase > Project Settings > API

  const userApiKey = (payload && payload.apiKey) 
    ? payload.apiKey 
    : PropertiesService.getUserProperties().getProperty('USER_API_KEY');

  if (!userApiKey) {
    throw new Error('Chưa có API Key. Vui lòng nhập key để kích hoạt.');
  }

  const route = path ? (path.startsWith('/') ? path : '/' + path) : '/init';

