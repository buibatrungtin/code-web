function runAndSaveTaskConfig(task) {
    if (task && ['fanpage_insights','post_insights'].includes(task.serviceType)) return dcStartFanpage_(task, true);
    try {
        // 1. Lưu cấu hình Task (Giữ nguyên logic cũ)
        const saveResult = callApi_('/manage', { resource: 'task', action: 'save', payload: task });
        const savedTask = saveResult.data.savedTask;
        updateMasterTrigger();

        // 2. Chuẩn bị Sheet (Giữ nguyên logic cũ)
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        const timezone = ss.getSpreadsheetTimeZone();
        let sh = ss.getSheetByName(savedTask.targetSheetName);
        if (!sh) {
            sh = ss.insertSheet(savedTask.targetSheetName);
        }
        
        // [QUAN TRỌNG] Đã XÓA đoạn code đọc existingRows ở đây để tránh lỗi Payload quá tải
        
        // 3. Gọi API (Chỉ gửi Task, không gửi dữ liệu cũ)
        savedTask.timezone = timezone;
        
        // Gọi endpoint /execute
        const executeResult = callApi_('/execute', { task: savedTask });

        // 4. Xử lý kết quả trả về
        // Server trả về 'newRowsData' (dữ liệu mới) thay vì 'finalRows' (tất cả dữ liệu)
        if (executeResult.ok && executeResult.data.newRowsData) {
            
            // [THAY ĐỔI LỚN] Gọi hàm merge bên file MergeLogic.gs
            // Hàm này sẽ thay thế đoạn code dài dòng xử lý Date và setValues cũ
            if(executeResult.data.columnIds) mergePostLayout_(sh,executeResult.data,savedTask);
            else mergeAndWriteData_(sh, executeResult.data.newRowsData, executeResult.data.headers, savedTask);

            // 5. Format và làm mới UI (Giữ nguyên logic cũ)
            if(!executeResult.data.columnIds) formatSheetForService(sh, savedTask, executeResult.data.headers.length);
            sh.activate();

            const finalData = callApi_('/init', {});
            if (finalData.ok) {
                finalData.data.message = executeResult.data.message || "Đã chạy và lưu Task thành công!";
                finalData.data.hasApiKey = true;
                finalData.data.pagesJson = finalData.data.tokensJson || "[]"; 
                return finalData.data;
            } else {
                throw new Error("Không thể làm mới dữ liệu sau khi chạy task");
            }
        } else {
            throw new Error(executeResult.error || 'API không trả về kết quả hợp lệ khi thực thi');
        }
    } catch (error) {
        throw new Error("Thao tác thất bại. Vui lòng kiểm tra lại cấu hình Task. Lỗi: " + error.message);
    }
}

function runExistingTask(task) {
    if (task && ['fanpage_insights','post_insights'].includes(task.serviceType)) return dcStartFanpage_(task, false);
    try {
        // 1. Chuẩn bị Sheet (Giữ nguyên logic cũ)
        const ss = SpreadsheetApp.getActiveSpreadsheet();
        const timezone = ss.getSpreadsheetTimeZone();
        let sh = ss.getSheetByName(task.targetSheetName);
        if (!sh) {
            sh = ss.insertSheet(task.targetSheetName);
        }
        
        // [QUAN TRỌNG] Đã XÓA đoạn code đọc existingRows
        
        // 2. Gọi API
        task.timezone = timezone;
        
        const result = callApi_('/execute', { task: task });

        // 3. Xử lý kết quả
        if (result.ok && result.data.newRowsData) {
            
            // [THAY ĐỔI LỚN] Uỷ quyền việc gộp dữ liệu cho hàm MergeLogic
            if(result.data.columnIds) mergePostLayout_(sh,result.data,task);
            else mergeAndWriteData_(sh, result.data.newRowsData, result.data.headers, task);

            // 4. Format và làm mới UI (Giữ nguyên logic cũ)
            if(!result.data.columnIds) formatSheetForService(sh, task, result.data.headers.length);
            sh.activate();
            
            const finalData = callApi_('/init', {});
            if (finalData.ok) {
                finalData.data.message = result.data.message || "Chạy task thành công!";
                finalData.data.hasApiKey = true;
                finalData.data.pagesJson = finalData.data.tokensJson || "[]";
                return finalData.data;
            } else {
                 throw new Error("Không thể làm mới dữ liệu sau khi chạy task");
            }
        } else {
            throw new Error(result.error || 'API không trả về kết quả hợp lệ');
        }
    } catch (error) {
        throw new Error("Thao tác thất bại. Vui lòng kiểm tra lại cấu hình Task. Lỗi: " + error.message);
    }
}

function getRealLastRow_(sheet, keyColumn) {
  const allValues = sheet.getRange(keyColumn + "1:" + keyColumn + sheet.getMaxRows()).getValues();
  for (let i = allValues.length - 1; i >= 0; i--) {
    if (allValues[i][0] !== "") {
      return i + 1;
    }
  }
  return 1;
}

