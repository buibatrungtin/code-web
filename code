function updateMasterTrigger() {
  const handlerFunction = 'executeScheduledTasks';
  const triggers = ScriptApp.getProjectTriggers();
  
  const existingTrigger = triggers.find(t => t.getHandlerFunction() === handlerFunction);

  if (!existingTrigger) {
    ScriptApp.newTrigger(handlerFunction)
      .timeBased()
      .everyHours(1)
      .create();
    Logger.log('Đã tạo mới lịch chạy thành công.');
  } else {
    Logger.log('Thành công');
  }
}

function executeScheduledTasks() {
  try {
    const result = callApi_('/manage', { resource: 'task', action: 'list' });
    const tasks = JSON.parse(result.data.tasksJson || '[]');

    if (tasks.length === 0) {
      Logger.log('Không có task nào để chạy theo lịch.');
      return;
    }

    const timezone = SpreadsheetApp.getActiveSpreadsheet().getSpreadsheetTimeZone();
    const currentHour = parseInt(Utilities.formatDate(new Date(), timezone, 'HH'), 10);

    Logger.log(`Đang kiểm tra lịch chạy cho giờ ${currentHour}:00`);

    tasks.forEach(task => {
      if (task.schedule && task.schedule.type === 'daily') {
        const scheduledHour = parseInt(task.schedule.time.split(':')[0], 10);
        if (scheduledHour === currentHour) {
          Logger.log(`>>> Đang chạy task theo lịch: "${task.taskName}"`);
          try {
            runExistingTask(task);
          } catch (e) {
            Logger.log(`Lỗi khi chạy task theo lịch "${task.taskName}": ${e.message}`);
          }
        }
      }
    });
  } catch (e) {
    Logger.log(`Lỗi khi lấy danh sách task theo lịch: ${e.message}`);
  }
}

