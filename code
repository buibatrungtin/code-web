      'apikey': SUPABASE_ANON_KEY                        // ← THÊM DÒNG NÀY
    },
    muteHttpExceptions: true,
    payload: JSON.stringify(payload || {})
  });

  const responseText = res.getContentText() || '{}';
  let json;
  try {
    json = JSON.parse(responseText);
  } catch (e) {
    throw new Error('API trả về dữ liệu không hợp lệ (HTTP ' + res.getResponseCode() + ').');
  }

  if (res.getResponseCode() >= 400 || json.ok === false) {
    throw new Error(route + ': ' + (json.error || ('API lỗi HTTP ' + res.getResponseCode())));
  }

  // Lưu key vào bộ nhớ máy tính sau khi gọi API thành công
  PropertiesService.getUserProperties().setProperty('USER_API_KEY', userApiKey);

  return json;
}


