function loadInitialData() {
  const hasApiKey = !!PropertiesService.getUserProperties().getProperty('USER_API_KEY');
  if (!hasApiKey) {
    return { hasApiKey: false };
  }

  try {
    const result = callApi_('/init', {});
    if (result.ok && result.data) {
        result.data.hasApiKey = true;
        result.data.pagesJson = result.data.tokensJson || "[]"; 
        // Do not log the full initialization payload.
        return result.data;
    } else {
        throw new Error("API không trả về dữ liệu hợp lệ.");
    }
  } catch (e) {
    Logger.log("Không thể tải dữ liệu khởi tạo: " + e.message);
    throw new Error("Không thể tải dữ liệu khởi tạo: " + e.message);
  }
}

